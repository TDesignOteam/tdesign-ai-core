{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@tdesign/ai-shared": ["../shared/index.ts"],
      "@tdesign/ai-shared/*": ["../shared/*"],
      "@tdesign/ai-chat-engine": ["./index.ts"],
      "@tdesign/ai-chat-engine/*": ["./*"]
    }
  },
  "include": ["./**/*.ts", "../shared/**/*.ts"],
  "exclude": ["../../node_modules", "./dist"]
}
