{
  "name": "@tdesign/ai-chat-engine",
  "version": "0.0.3",
  "description": "TDesign ChatEngine - Framework-agnostic AI chat engine core",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./*": "./*.ts"
  },
  "files": [
    "dist",
    "README.md",
    "README-zh_CN.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "prepublishOnly": "node -e \"if (/^npm\\//.test(process.env.npm_config_user_agent || '')) { console.error('Use pnpm publish for @tdesign/ai-chat-engine.'); process.exit(1); }\"",
    "test": "vitest run --root ../.. packages/chat-engine"
  },
  "publishConfig": {
    "access": "public",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./iife": {
        "default": "./dist/index.iife.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TDesignOteam/tdesign-ai-core.git",
    "directory": "packages/chat-engine"
  },
  "homepage": "https://github.com/TDesignOteam/tdesign-ai-core#readme",
  "bugs": {
    "url": "https://github.com/TDesignOteam/tdesign-ai-core/issues"
  },
  "author": "tdesign",
  "license": "MIT",
  "dependencies": {
    "@json-render/core": "^0.19.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "immer": "^10.0.0"
  }
}
